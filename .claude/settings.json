{
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "mcp__UnityMCP__manage_scene",
      "mcp__UnityMCP__read_console",
      "mcp__UnityMCP__manage_camera",
      "mcp__UnityMCP__manage_components",
      "mcp__UnityMCP__validate_script",
      "mcp__UnityMCP__manage_prefabs",
      "mcp__UnityMCP__find_gameobjects",
      "mcp__UnityMCP__manage_editor",
      "mcp__UnityMCP__refresh_unity",
      "mcp__UnityMCP__manage_profiler",
      "mcp__UnityMCP__manage_gameobject",
      "mcp__UnityMCP__manage_scriptable_object",
      "mcp__UnityMCP__manage_material",
      "mcp__UnityMCP__manage_texture",
      "mcp__UnityMCP__manage_asset",
      "mcp__UnityMCP__run_tests",
      "mcp__UnityMCP__get_test_job",
      "mcp__UnityMCP__manage_build",
      "mcp__UnityMCP__batch_execute"
    ]
  },
  "mcpServers": {
    "unityMCP": {
      "url": "http://localhost:8080/mcp"
    }
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          { "type": "command", "command": ".claude/hooks/block-scene-edit.sh", "timeout": 3000 },
          { "type": "command", "command": ".claude/hooks/block-meta-edit.sh", "timeout": 3000 },
          { "type": "command", "command": ".claude/hooks/guard-editor-runtime.sh", "timeout": 5000 },
          { "type": "command", "command": ".claude/hooks/guard-known-issues-edit.sh", "timeout": 3000 }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": ".claude/hooks/block-git-commit.sh", "timeout": 3000 },
          { "type": "command", "command": ".claude/hooks/bash-gate.sh", "timeout": 3000 }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          { "type": "command", "command": ".claude/hooks/cs-lint.sh", "timeout": 10000 }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          { "type": "command", "command": ".claude/hooks/compile-gate.sh", "timeout": 150000 },
          { "type": "command", "command": ".claude/hooks/toast-alert.sh", "timeout": 3000 }
        ]
      }
    ]
  }
}
